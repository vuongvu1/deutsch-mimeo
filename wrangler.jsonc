{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deutsch-mimeo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Must live here, not in the dashboard: `wrangler deploy` treats this file as
  // the source of truth for plaintext vars and DELETES any it doesn't find here.
  // Dashboard-set Text vars survive exactly until the next deploy. Secrets
  // (TELEGRAM_BOT_TOKEN, GEMINI_API_KEY) are separate and do persist.
  //
  // None of these are credentials: the Supabase pair is already public in the
  // client bundle as VITE_* (anon-all RLS is the design), and the chat id can't
  // be posted to without the bot token.
  "vars": {
    "SUPABASE_URL": "https://fzvzmuhagvcbftmgpmff.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_vIncR8_-FGKX6dv6vhyF4w_TmxEes5I",
    "TELEGRAM_CHAT_ID": "-5149117879"
  },
  // Hourly, because Cloudflare crons are UTC-only and the nag slots are Berlin
  // local (every 2h, 10:00–22:00). isNagHour() picks the right ones, so DST needs
  // no config change twice a year. 24 invocations/day, well inside the free tier.
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
